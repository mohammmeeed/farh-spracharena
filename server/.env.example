# ==========================================
# Farh SprachArena - Backend Configuration
# ==========================================

# Port the Express & Socket.IO server listens on (default: 3001)
PORT=3001

# Production Node Environment (development | production)
NODE_ENV=production

# Allowed CORS Origins (Comma-separated or single domain)
# Example: https://farh-spracharena.de,https://www.farh-spracharena.de
CLIENT_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
