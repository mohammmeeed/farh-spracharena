{
  "name": "farh-spracharena-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend server for Farh SprachArena - Interaktive Deutsch-Lernplattform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "validate:questions": "tsx src/questions/validateCli.ts",
    "test:distribution": "tsx src/test-answer-distribution.ts",
    "test:anti-repetition": "tsx src/test-anti-repetition.ts",
    "test:multiplayer": "tsx src/test-multiplayer-e2e.ts"
  },

  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
