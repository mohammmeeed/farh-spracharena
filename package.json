{
  "name": "farh-spracharena",
  "version": "1.0.0",
  "private": true,
  "description": "Farh SprachArena - Interaktive Deutsch-Lernplattform für den Unterricht",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "build": "cd client && npm install && npm run build",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "validate:questions": "npm --prefix server run validate:questions",
    "test:distribution": "npm --prefix server run test:distribution",
    "test:anti-repetition": "npm --prefix server run test:anti-repetition",
    "test:multiplayer": "npm --prefix server run test:multiplayer"
  },
  "dependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "keywords": ["german-learning", "classroom-game", "socket.io", "react", "express", "farh-spracharena"],
  "author": "Farh SprachArena Team"
}
